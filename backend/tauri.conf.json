{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "port-helper",
  "version": "0.1.6",
  "identifier": "dev.porthelper.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "pnpm --dir frontend dev",
    "beforeBuildCommand": "pnpm --dir frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "port-helper",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFRTM2QzQyRUZFNjkyM0MKUldROGt1YnZRbXpqRGlua0d6TCtNVFV5MGo3anVpVFZFMWx0dkZHeVltV3NwYjN1T0xabFFsWFAK",
      "endpoints": ["https://github.com/haishishushu/port-helper/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
